{
  "name": "call-e",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "npm --workspace apps/web run start",
    "build": "npm --workspace apps/web run build",
    "build:web": "npm --workspace apps/web run build",
    "test:api": "cd apps/api && python3 -m pytest tests -v"
  },
  "packageManager": "npm@10.9.2"
}
